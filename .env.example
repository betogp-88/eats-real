# Proyecto de Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Empresa que sirve esta instancia. Sin estas variables es Eats Real (esquema public).
# Para otra empresa en el mismo proyecto de Supabase (ver supabase/empresas/):
# NEXT_PUBLIC_EMPRESA=maix              # clave de membresía y, por default, esquema y nombre
# NEXT_PUBLIC_DB_SCHEMA=maix            # esquema de Postgres (opcional si es igual al slug)
# NEXT_PUBLIC_MARCA_NOMBRE=Maix
# NEXT_PUBLIC_MARCA_LOGO=/logos/maix.png   # o "none" para usar iniciales
# NEXT_PUBLIC_COLOR_PRIMARIO=#1f2a44
# NEXT_PUBLIC_COLOR_SECUNDARIO=#7aa2e3
# NEXT_PUBLIC_COLOR_ACENTO=#f2b134
# NEXT_PUBLIC_COLOR_ACENTO_SUAVE=#f9dca0
# NEXT_PUBLIC_COLOR_FONDO=#f7f7fb
